{
  "name": "overload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "browserslist": "> 1%",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --project dom",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "db:branch": "tsx scripts/db-branch.ts",
    "auth:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://u:p@localhost:5432/db} BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET:-generate-only-placeholder-secret} auth generate --config src/server/auth/auth.ts --output prisma/auth.generated.prisma --yes",
    "ownership:check": "tsx scripts/ownership-check.ts",
    "test:integration": "vitest run --project integration",
    "test:analytics-coverage": "vitest run --project unit --project dom --coverage --coverage.include=\"src/lib/analytics/**\" --coverage.exclude=\"**/*.test.ts\" --coverage.thresholds.lines=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=90",
    "docs:sync": "tsx scripts/docs-sync.ts",
    "docs:check": "tsx scripts/docs-sync.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@better-auth/passkey": "1.7.8",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@serwist/turbopack": "9.5.13",
    "@vercel/functions": "3.10.1",
    "better-auth": "1.7.8",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "esbuild": "0.28.2",
    "fractional-indexing": "4.0.0",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "resend": "6.33.0",
    "server-only": "0.0.1",
    "serwist": "9.5.13",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "auth": "1.7.8",
    "daisyui": "5.7.50",
    "dotenv": "18.0.8",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "neonctl": "8.4.4",
    "picomatch": "4.0.7",
    "prisma": "^7.10.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
