// Overload schema. FROZEN after Phase 0 (additive-only after Wave 1; see CLAUDE.md change-request protocol).
//
// Layout: generator/datasource -> enums -> domain models -> Better Auth models (generated by
// `pnpm auth:generate`, kept verbatim) with the domain back-relations appended to `User`.
//
// Conventions
//  - Every row a client can write has a client-generated UUIDv7 id (@db.Uuid); catalog exercises use UUIDv5.
//  - Weights are stored in kg as Decimal(7,3). Decimal NEVER leaves src/server (mappers convert to number).
//  - SYNC MIXIN (the 8 synced models: Exercise, MachineProfile, BodyMetric, Template, TemplateExercise,
//    Workout, WorkoutExercise, WorkoutSet): hlc, fieldHlc, version, deletedAt, createdAt, updatedAt, @@index([userId, version]).
//  - Never accepted from the client: userId, version, hlc, fieldHlc, denormalized foreign keys
//    (WorkoutSet.workoutId/exerciseId/machineProfileId/seriesKey/localDate), effectiveLoadKg, e1rmKg.
//  - Cross-entity foreign keys use onDelete: NoAction (checked at end of statement) so deleting a User can
//    cascade through the whole graph without ordering errors. Parent->child ownership uses Cascade.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── enums ─────────────────────────────

enum Sex {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY // formula coefficients; PREFER_NOT -> averaged coeffs, percentiles hidden
}

enum WeightUnit {
  KG
  LB // display/entry only; storage is kg
}

enum EffortScale {
  RIR
  RPE // display only; stored as RIR (RPE = 10 - RIR)
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingGoal {
  HYPERTROPHY
  STRENGTH
  GENERAL
  FAT_LOSS
}

enum BodyFatMethod {
  SCALE
  BIA
  DEXA
  NAVY_TAPE
  CALIPERS
  VISUAL
}

enum Modality {
  FREE_WEIGHT
  MACHINE
  CABLE
  BODYWEIGHT
  BAND
  OTHER
}

enum Equipment {
  BARBELL
  DUMBBELL
  KETTLEBELL
  EZ_BAR
  TRAP_BAR
  PLATE
  MEDICINE_BALL
  SMITH_MACHINE
  MACHINE_SELECTORIZED
  MACHINE_PLATE_LOADED
  CABLE
  BODYWEIGHT
  BAND
  EXERCISE_BALL
  FOAM_ROLL
  OTHER
}

enum LoadType {
  TOTAL
  PER_IMPLEMENT
  PLATES_PER_SIDE
  STACK
  BODYWEIGHT_PLUS
  NONE
}

enum TrackingType {
  LOAD_REPS
  REPS
  DURATION
  DISTANCE_DURATION
}

enum Mechanic {
  COMPOUND
  ISOLATION
}

enum Force {
  PUSH
  PULL
  STATIC
}

enum ExerciseCategory {
  STRENGTH
  POWERLIFTING
  OLYMPIC_WEIGHTLIFTING
  STRONGMAN
  PLYOMETRICS
  STRETCHING
  CARDIO
}

enum Muscle {
  ABDOMINALS
  ABDUCTORS
  ADDUCTORS
  BICEPS
  CALVES
  CHEST
  FOREARMS
  GLUTES
  HAMSTRINGS
  LATS
  LOWER_BACK
  MIDDLE_BACK
  NECK
  QUADRICEPS
  SHOULDERS
  TRAPS
  TRICEPS
}

enum MuscleRole {
  PRIMARY // weekly sets: 1.0
  SECONDARY // weekly sets: 0.5
}

enum StandardLift {
  SQUAT
  BENCH_PRESS
  DEADLIFT
  OVERHEAD_PRESS
  BARBELL_ROW
  PULL_UP
  DIP
}

enum SetType {
  WARMUP // excluded from volume and PRs
  WORKING
  DROP // excluded from e1RM and PRs
  AMRAP
}

enum PrType {
  E1RM
  MAX_LOAD
  REP_MAX
  MAX_REPS
  MAX_SET_VOLUME
  MAX_SESSION_VOLUME
}

enum E1rmFormula {
  EPLEY
  BRZYCKI
}

enum InsightStatus {
  PENDING
  READY
  FAILED
}

enum InsightTrigger {
  CRON
  ON_DEMAND
}

// ───────────────────────────── user-level (not synced) ─────────────────────────────

/// Not synced; written by Server Actions only (stream A owns the actions).
model Profile {
  userId          String           @id
  sex             Sex?
  birthDate       DateTime?        @db.Date
  heightCm        Decimal?         @db.Decimal(5, 1)
  unitPreference  WeightUnit       @default(KG)
  effortScale     EffortScale      @default(RIR)
  experience      ExperienceLevel?
  goal            TrainingGoal?
  e1rmFormula     E1rmFormula      @default(EPLEY)
  timezone        String           @default("UTC")
  defaultRestSec  Int              @default(120)
  insightsEnabled Boolean          @default(true)
  onboardedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per user. `version` is the monotonically increasing per-user change counter used as the
/// sync cursor; the sync transaction locks this row (SELECT ... FOR UPDATE) to serialize pushes.
model SyncState {
  userId         String   @id
  version        Int      @default(0)
  gcFloorVersion Int      @default(0) // tombstones with version <= this are gone; clients with an older cursor must reset
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Mutations the server refused (bad owner/reference/shape). Kept for debugging; never blocks a batch.
/// NOTE: not in the plan's Appendix A (which mentions a "dead-letter queue" without a table); added in Phase 0.
model SyncDeadLetter {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String
  mutationId String
  entity     String
  entityId   String
  reason     String
  payload    Json
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Singleton (id = 1). `version` bumps whenever the global catalog is reseeded; it is the ETag source for /api/catalog.
model CatalogMeta {
  id        Int      @id @default(1)
  version   Int
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── synced models ─────────────────────────────

/// userId null = global catalog row (read-only for users, served by /api/catalog, hlc "" / version 0).
/// userId set = the user's custom exercise (synced).
model Exercise {
  id               String           @id @db.Uuid
  userId           String?
  sourceId         String?          @unique
  slug             String
  name             String
  aliases          String[]
  modality         Modality
  equipment        Equipment
  loadType         LoadType
  tracking         TrackingType     @default(LOAD_REPS)
  bodyweightFactor Decimal?         @db.Decimal(3, 2)
  isUnilateral     Boolean          @default(false)
  mechanic         Mechanic?
  force            Force?
  level            ExperienceLevel?
  category         ExerciseCategory
  standardLift     StandardLift?
  instructions     String[]
  images           String[]

  // sync mixin
  hlc       String
  fieldHlc  Json      @default("{}")
  version   Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscles           ExerciseMuscle[]
  machineProfiles   MachineProfile[]
  favorites         ExerciseFavorite[]
  templateExercises TemplateExercise[]
  workoutExercises  WorkoutExercise[]
  workoutSets       WorkoutSet[]
  personalRecords   PersonalRecord[]

  @@index([modality, equipment])
  @@index([userId, version])
}

/// Muscles are NOT a synced model: for custom exercises they travel as the `muscles` field of the
/// Exercise mutation and the server materializes these rows (see CONTRACTS.md, "Exercise muscles").
model ExerciseMuscle {
  exerciseId String     @db.Uuid
  muscle     Muscle
  role       MuscleRole

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscle])
  @@index([muscle, role])
}

/// Per-user gym/brand instance of a machine; keys machine progression series (seriesKey = exerciseId:machineProfileId).
model MachineProfile {
  id         String      @id @db.Uuid
  userId     String
  name       String
  gymName    String?
  brand      String?
  exerciseId String?     @db.Uuid
  labelUnit  WeightUnit?
  pinStepKg  Decimal?    @db.Decimal(6, 3)
  baseLoadKg Decimal?    @db.Decimal(6, 2)
  /// Plate weights (kg) the gym owns, for bar and plate-loaded profiles. Empty means the standard set for the unit
  /// (the wire value is null; Prisma scalar lists cannot be null).
  platesKg   Decimal[]   @db.Decimal(6, 2)
  notes      String?

  // sync mixin
  hlc       String
  fieldHlc  Json      @default("{}")
  version   Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise          Exercise?          @relation(fields: [exerciseId], references: [id], onDelete: NoAction)
  templateExercises TemplateExercise[]
  workoutExercises  WorkoutExercise[]
  workoutSets       WorkoutSet[]
  personalRecords   PersonalRecord[]

  @@index([userId, exerciseId])
  @@index([userId, version])
}

/// A user's starred exercise. The id is deterministic (uuidv5 of `${userId}:${exerciseId}`, see favoriteId() in
/// src/lib/ids.ts) so two offline devices converge on the same row; there is deliberately no unique constraint on
/// (userId, exerciseId). Unfavorite = tombstone (deletedAt); favoriting again restores it with a newer HLC.
model ExerciseFavorite {
  id         String @id @db.Uuid
  userId     String
  exerciseId String @db.Uuid
  /// fractional index (append on create; manual reorder later)
  position   String

  // sync mixin
  hlc       String
  fieldHlc  Json      @default("{}")
  version   Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: NoAction)

  @@index([userId, version])
  @@index([userId, exerciseId])
}

model BodyMetric {
  id            String         @id @db.Uuid
  userId        String
  measuredAt    DateTime
  localDate     DateTime       @db.Date
  weightKg      Decimal?       @db.Decimal(6, 2)
  bodyFatPct    Decimal?       @db.Decimal(4, 1)
  bodyFatMethod BodyFatMethod?
  neckCm        Decimal?       @db.Decimal(5, 1)
  waistCm       Decimal?       @db.Decimal(5, 1)
  hipCm         Decimal?       @db.Decimal(5, 1)
  chestCm       Decimal?       @db.Decimal(5, 1)
  armCm         Decimal?       @db.Decimal(5, 1)
  thighCm       Decimal?       @db.Decimal(5, 1)
  calfCm        Decimal?       @db.Decimal(5, 1)
  notes         String?

  // sync mixin
  hlc       String
  fieldHlc  Json      @default("{}")
  version   Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
  @@index([userId, version])
}

model Template {
  id       String  @id @db.Uuid
  userId   String
  name     String
  notes    String?
  folder   String?
  position String // fractional index

  // sync mixin
  hlc       String
  fieldHlc  Json      @default("{}")
  version   Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises TemplateExercise[]
  workouts  Workout[]

  @@index([userId, version])
}

model TemplateExercise {
  id               String   @id @db.Uuid
  userId           String
  templateId       String   @db.Uuid
  exerciseId       String   @db.Uuid
  machineProfileId String?  @db.Uuid
  position         String // fractional index
  warmupSets       Int      @default(0)
  workingSets      Int      @default(3)
  repMin           Int?
  repMax           Int?
  targetRir        Decimal? @db.Decimal(3, 1)
  restSec          Int?
  supersetKey      String?
  notes            String?

  // sync mixin
  hlc       String
  fieldHlc  Json      @default("{}")
  version   Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template       Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id], onDelete: NoAction)
  machineProfile MachineProfile? @relation(fields: [machineProfileId], references: [id], onDelete: NoAction)

  @@index([templateId, position])
  @@index([userId, version])
}

model Workout {
  id           String    @id @db.Uuid
  userId       String
  templateId   String?   @db.Uuid
  title        String?
  startedAt    DateTime
  endedAt      DateTime?
  localDate    DateTime  @db.Date // device-local date when the workout started; the ONLY field used to group by day/week
  timezone     String
  bodyweightKg Decimal?  @db.Decimal(6, 2)
  isDeload     Boolean   @default(false)
  notes        String?

  // sync mixin
  hlc       String
  fieldHlc  Json      @default("{}")
  version   Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        Template?         @relation(fields: [templateId], references: [id], onDelete: NoAction)
  exercises       WorkoutExercise[]
  sets            WorkoutSet[]
  personalRecords PersonalRecord[]

  @@index([userId, localDate])
  @@index([userId, version])
}

model WorkoutExercise {
  id               String  @id @db.Uuid
  userId           String
  workoutId        String  @db.Uuid
  exerciseId       String  @db.Uuid
  machineProfileId String? @db.Uuid
  position         String // fractional index
  supersetKey      String?
  restSec          Int?
  notes            String?

  // sync mixin
  hlc       String
  fieldHlc  Json      @default("{}")
  version   Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout        Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id], onDelete: NoAction)
  machineProfile MachineProfile? @relation(fields: [machineProfileId], references: [id], onDelete: NoAction)
  sets           WorkoutSet[]

  @@index([workoutId, position])
  @@index([userId, exerciseId])
  @@index([userId, version])
}

/// Named WorkoutSet so it never shadows the JavaScript `Set`.
model WorkoutSet {
  id                String @id @db.Uuid
  userId            String
  workoutExerciseId String @db.Uuid

  // server-derived (never accepted from the client; the client repo mirrors them locally for offline reads)
  workoutId        String   @db.Uuid
  exerciseId       String   @db.Uuid
  machineProfileId String?  @db.Uuid
  seriesKey        String // exerciseId, or `${exerciseId}:${machineProfileId}` (see src/lib/ids.ts)
  localDate        DateTime @db.Date
  effectiveLoadKg  Decimal? @db.Decimal(7, 3)
  e1rmKg           Decimal? @db.Decimal(7, 3)

  // client-writable
  position    String // fractional index
  setType     SetType     @default(WORKING)
  weightKg    Decimal?    @db.Decimal(7, 3)
  inputUnit   WeightUnit?
  reps        Int?
  rir         Decimal?    @db.Decimal(3, 1)
  durationSec Int?
  distanceM   Decimal?    @db.Decimal(9, 2)
  completedAt DateTime? // null = planned
  notes       String?

  // sync mixin
  hlc       String
  fieldHlc  Json      @default("{}")
  version   Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  workout         Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: NoAction)
  machineProfile  MachineProfile? @relation(fields: [machineProfileId], references: [id], onDelete: NoAction)

  @@index([userId, exerciseId, localDate])
  @@index([userId, seriesKey, completedAt])
  @@index([userId, localDate])
  @@index([workoutExerciseId, position])
  @@index([userId, version])
}

// ───────────────────────────── server-derived ─────────────────────────────

/// Rebuilt per seriesKey inside the sync transaction. `setId` and `machineProfileId`-less rows are plain
/// values (no FK on setId: sets can be tombstoned/garbage-collected independently).
model PersonalRecord {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String
  exerciseId       String   @db.Uuid
  machineProfileId String?  @db.Uuid
  seriesKey        String
  type             PrType
  reps             Int      @default(0)
  value            Decimal  @db.Decimal(12, 3)
  previousValue    Decimal? @db.Decimal(12, 3)
  setId            String?  @db.Uuid
  workoutId        String   @db.Uuid
  achievedAt       DateTime
  computedAt       DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id], onDelete: NoAction)
  machineProfile MachineProfile? @relation(fields: [machineProfileId], references: [id], onDelete: NoAction)
  workout        Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesKey, type, reps])
  @@index([userId, achievedAt])
}

model InsightReport {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String
  weekStart     DateTime       @db.Date
  status        InsightStatus  @default(PENDING)
  trigger       InsightTrigger
  factsVersion  Int
  facts         Json
  factsHash     String
  narrative     Json?
  model         String?
  promptVersion String?
  inputTokens   Int?
  outputTokens  Int?
  error         String?
  onDemandCount Int            @default(0)
  generatedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([status, createdAt])
}

// ───────────────────────────── Better Auth (generated by `pnpm auth:generate`) ─────────────────────────────
// emailAndPassword + google + passkey + database rate limiting. Domain back-relations appended to User.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]

  // domain back-relations (appended in Phase 0; every one cascades on user deletion)
  profile           Profile?
  syncState         SyncState?
  syncDeadLetters   SyncDeadLetter[]
  exercises         Exercise[]
  machineProfiles   MachineProfile[]
  exerciseFavorites ExerciseFavorite[]
  bodyMetrics       BodyMetric[]
  templates         Template[]
  templateExercises TemplateExercise[]
  workouts          Workout[]
  workoutExercises  WorkoutExercise[]
  workoutSets       WorkoutSet[]
  personalRecords   PersonalRecord[]
  insightReports    InsightReport[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
