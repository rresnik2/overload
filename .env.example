# Overload environment. Copy to .env.local and fill in. NEVER commit .env.local. Agents never see real values:
# the owner (Reece) creates these accounts and puts the secrets in .env.local himself.

# ── Database (Neon Postgres) ──────────────────────────────────────────────────────────────────────
# Neon console > your project > Dashboard > "Connect": choose the POOLED connection string (host contains "-pooler").
# Used at runtime by the app (src/server/db.ts, @prisma/adapter-pg).
DATABASE_URL=
# Same page, the DIRECT (unpooled) connection string. Used ONLY by the Prisma CLI (migrate deploy, studio) via prisma.config.ts.
DIRECT_URL=
# Optional: an empty scratch database, only for `pnpm db:diff` (prisma migrate diff --from-migrations). CI sets this itself.
SHADOW_DATABASE_URL=

# ── Neon branch-per-worktree (scripts/db-branch.ts, `pnpm db:branch <stream>`) ────────────────────
# Neon console > Account settings > API keys > "Create new API key".
NEON_API_KEY=
# Neon console > your project > Settings > General > Project ID (looks like "icy-forest-12345678").
NEON_PROJECT_ID=
# Optional: branch to fork new worktree branches from (name or id). Default: the project's default branch.
NEON_PARENT_BRANCH=
# Optional: database and role names on the Neon project. Defaults: neondb / neondb_owner.
NEON_DATABASE_NAME=
NEON_ROLE_NAME=

# ── Better Auth ───────────────────────────────────────────────────────────────────────────────────
# Generate locally: `openssl rand -base64 32`. Must be stable per environment (rotating it signs everyone out).
BETTER_AUTH_SECRET=
# Public origin of this app. Local: http://localhost:3000 (a worktree on port 3003 uses http://localhost:3003). Vercel: the deployment domain.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Passkeys: relying-party id = the bare hostname users see ("localhost" locally, "overload.example.com" in production).
# Leave empty to derive it from BETTER_AUTH_URL.
PASSKEY_RP_ID=
PASSKEY_RP_NAME=Overload

# ── Google OAuth (sign in with Google) ────────────────────────────────────────────────────────────
# Google Cloud console > APIs & Services > Credentials > Create credentials > OAuth client ID (Web application).
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google (+ one per worktree port you use, 3001-3005)
# and https://<your-vercel-domain>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Resend (verification + password-reset email) ──────────────────────────────────────────────────
# resend.com > API Keys > Create API key.
RESEND_API_KEY=
# From address. "Overload <onboarding@resend.dev>" works for development; use your verified domain in production.
EMAIL_FROM=Overload <onboarding@resend.dev>

# ── Anthropic (weekly insight narratives, stream G) ───────────────────────────────────────────────
# console.anthropic.com > API keys.
ANTHROPIC_API_KEY=
# Model that writes the in-app weekly narrative (NOT the model that builds the app).
INSIGHTS_MODEL=claude-opus-5-5
# Set to 1 to run the opt-in live Anthropic test (costs tokens).
INSIGHTS_LIVE=

# ── Cron ──────────────────────────────────────────────────────────────────────────────────────────
# Generate locally: `openssl rand -hex 32`. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ── Tests ─────────────────────────────────────────────────────────────────────────────────────────
# Playwright: point at an already-running server instead of letting Playwright start `pnpm dev` (optional).
E2E_BASE_URL=
# Per-worktree dev-server port (A 3001, B 3002, C 3003, D 3004, E1 3005; Wave 2: E2 3001, F 3002, G 3003).
PORT=3000

# Optional: max pooled connections per server instance (default 10).
DATABASE_POOL_MAX=

# Measurement only (e2e/perf, docs/perf/baseline.md): set to 1 to count Prisma queries and database time per page request.
# Each request logs one "[server-timing]" line and is served from /api/perf/server-timing. Leave empty otherwise (zero cost).
OVERLOAD_SERVER_TIMING=
